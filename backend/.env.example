PORT=5000
NODE_ENV=development


# Backblaze B2 credentials. Keep real values in backend/.env.local.
BACKBLAZE_KEY_ID=
BACKBLAZE_KEY_NAME=
BACKBLAZE_APPLICATION_KEY=

JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
